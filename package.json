{
  "name": "summit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:deploy && node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.renameSync('dist-deploy','dist')\"",
    "build:summit": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:climb": "vite --config vite.climb.config.js",
    "build:climb": "vite build --config vite.climb.config.js",
    "build:deploy": "vite build --config vite.climb.config.js --mode deploy && vite build --mode deploy",
    "regression": "node scripts/tests/run-summit-regression.mjs",
    "check:deploy": "npm run build:deploy && node scripts/tests/deploy-check.mjs dist-deploy"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "vite": "^8.3.4",
    "vitest": "^3.2.4"
  }
}
