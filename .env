# The address the site will be served from. Link previews (og:image) need a full address, so every page reads it
# from here at build time. summit.khaylub.com is the planned host; change it here if that changes.
VITE_SITE_URL=https://summit.khaylub.com

# Where the Summit lives, as the Climb links to it. Its path is also the Summit's base (vite.config.js): "/" here.
VITE_SUMMIT_URL=https://summit.khaylub.com/
